# Public origin of the CMS, with no path. Use the actual production domain.
CMS_ORIGIN=https://your-site.example
# GitHub Settings > Developer settings > OAuth Apps.
# Callback URL must be CMS_ORIGIN + /api/callback.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Mail delivery. Keep these values on the server, never in HTML or public JSON.
# Obtain SMTP settings and sender authorization from your mail provider.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
CONTACT_FROM=
CONTACT_TO=
# Use a stable random secret (required on Vercel).
# Generate locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
CONTACT_TOKEN_SECRET=
# Optional extra allowed frontend origins, comma-separated, no paths/trailing slash.
CONTACT_ALLOWED_ORIGINS=
# Public setting. Only the endpoint URL is included in the static export.
# Keep /api/contact when the frontend and mail backend share the same origin.
CONTACT_FORM_ENDPOINT=/api/contact
